# Use `npm run configure:local` for a safe interactive local setup, or configure
# these values in private Codespaces Secrets. Never commit .env or .env.local.
# Next.js sets NODE_ENV for dev/build/start; do not set it in this file.
APP_PASSWORD=replace-with-a-long-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=./data/mynutri.sqlite

# Gemini provider configuration. Use private Codespaces Secrets or configure:local.
# Keep each slot unique where possible; the provider tries configured slots with cooldown/failover.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
# Legacy fallback for existing deployments; used when numbered slots are absent.
GEMINI_API_KEY=
# Explicit model name. The example is not a guarantee that this model is available
# to your Google AI project; verify availability before enabling live AI requests.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=6
GEMINI_REQUEST_TIMEOUT_MS=60000
GEMINI_KEY_COOLDOWN_MS=60000
GEMINI_MAX_IMAGE_MB=8

# Optional agent controls (bounded by code-side limits).
AGENT_AUTO_SCAN=true
AGENT_SCAN_INTERVAL_MINUTES=30
AGENT_AUTO_FIX_SAFE_BUGS=true
AGENT_MAX_REPAIR_ATTEMPTS=3
AGENT_CHECK_TIMEOUT_MS=900000
AGENT_UPGRADE_MAX_ROUNDS=8
AGENT_UPGRADE_CHECK_TIMEOUT_MS=900000
AGENT_UPGRADE_MAX_OUTPUT_TOKENS=24576

APP_URL=http://localhost:3000
PHOTO_RETENTION=never
